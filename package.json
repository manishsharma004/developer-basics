{
  "name": "developer-basics",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "An interactive React + TypeScript playground for learning developer basics, powered by real in-browser Python simulation (Pyodide).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "sitemap": "bun scripts/generate-sitemap.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "v86:download-bios": "bash scripts/v86/download-bios.sh",
    "v86:build-image": "bash scripts/v86/build-lab-image.sh",
    "v86:fetch-lab-image": "bash scripts/v86/download-lab-image.sh",
    "archify:install": "bash scripts/install-archify-skill.sh",
    "architecture:deliver": "bash scripts/architecture-deliver.sh",
    "kafka:up": "docker compose -f compose/kafka-lab.yaml up -d",
    "kafka:down": "docker compose -f compose/kafka-lab.yaml down",
    "kafka:broker": "bun scripts/start-kafka-broker.mjs",
    "kafka:lab": "bun scripts/kafka-lab-server.mjs",
    "dev:kafka": "bash scripts/dev-with-kafka.sh"
  },
  "dependencies": {
    "@platformatic/kafka": "^2.11.0",
    "@wasmer/sdk": "^0.10.0",
    "coi-serviceworker": "^0.1.7",
    "fuse.js": "^7.5.0",
    "kafkajs": "^2.2.4",
    "mermaid": "^11.17.0",
    "monaco-editor": "^0.53.0",
    "pyodide": "^314.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.1",
    "tiny-kafka": "github:tulios/tiny-kafka",
    "v86": "^0.5.451",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/xterm": "^3.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0"
  }
}
